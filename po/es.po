"A newer kernel ({arg0}) is installed, but you are still running {arg1}. "
"Restart the computer, then scan again — you will probably be able to remove "
"one more kernel."
msgstr ""
"Hay un kernel más nuevo ({arg0}) instalado, pero todavía estás usando "
"{arg1}. Reiniciá el equipo y volvé a escanear: probablemente puedas eliminar "
"un kernel más."

#: src/safe_disk_cleaner/scanners.py:132
#, python-brace-format
msgid "Linux kernel {arg0}"
msgstr "Kernel de Linux {arg0}"

#: src/safe_disk_cleaner/scanners.py:133
#, python-brace-format
