#: src/safe_disk_cleaner/cache_info.py:12
msgid ""
"Web pages, images and scripts the browser saved so sites load faster. "
"Logins, bookmarks, history and passwords are NOT stored here. Sites will "
"load a little slower the first time after cleaning."
msgstr ""
"Páginas web, imágenes y scripts que el navegador guardó para que los sitios "
"carguen más rápido. Los inicios de sesión, marcadores, historial y "
"contraseñas NO se guardan acá. Los sitios cargarán un poco más lento la "
"primera vez después de limpiar."

#: src/safe_disk_cleaner/cache_info.py:16
msgid "Firefox web cache"
msgstr "Caché web de Firefox"

#: src/safe_disk_cleaner/cache_info.py:17
msgid "Google Chrome web cache"
msgstr "Caché web de Google Chrome"

#: src/safe_disk_cleaner/cache_info.py:18
msgid "Chromium web cache"
msgstr "Caché web de Chromium"

#: src/safe_disk_cleaner/cache_info.py:19
msgid "Brave web cache"
msgstr "Caché web de Brave"

#: src/safe_disk_cleaner/cache_info.py:20
msgid "Vivaldi web cache"
msgstr "Caché web de Vivaldi"

#: src/safe_disk_cleaner/cache_info.py:21
msgid "Microsoft Edge web cache"
msgstr "Caché web de Microsoft Edge"

#: src/safe_disk_cleaner/cache_info.py:22
msgid "Opera web cache"
msgstr "Caché web de Opera"

#: src/safe_disk_cleaner/cache_info.py:23
msgid "GNOME Web cache"
msgstr "Caché web de GNOME Web"

#: src/safe_disk_cleaner/cache_info.py:24
msgid "Thunderbird cache"
msgstr "Caché de Thunderbird"

#: src/safe_disk_cleaner/cache_info.py:25
msgid ""
"Temporary data from Thunderbird. Your mail is stored elsewhere and is not "
"touched."
msgstr ""
"Datos temporales de Thunderbird. Tu correo está guardado en otro lado y no "
"se toca."

#: src/safe_disk_cleaner/cache_info.py:27
msgid "Evolution mail cache"
msgstr "Caché de correo de Evolution"

#: src/safe_disk_cleaner/cache_info.py:28
msgid ""
"Evolution keeps OFFLINE COPIES of your mail and calendars here. They will be "
"re-downloaded from the server, but anything only stored locally could be "
"lost. Review first."
msgstr ""
"Evolution guarda acá COPIAS SIN CONEXIÓN de tu correo y calendarios. Se "
"volverán a descargar del servidor, pero lo que solo exista localmente podría "
"perderse. Revisar antes."

#: src/safe_disk_cleaner/cache_info.py:31
msgid "GNOME search index"
msgstr "Índice de búsqueda de GNOME"

#: src/safe_disk_cleaner/cache_info.py:32
msgid ""
"The index that lets the Activities search find your files instantly. It is "
"rebuilt automatically; the computer may be busy for a while afterwards."
msgstr ""
"El índice que permite que la búsqueda de Actividades encuentre tus archivos "
"al instante. Se reconstruye solo; el equipo puede estar ocupado un rato "
"después."

#: src/safe_disk_cleaner/cache_info.py:33
msgid "Font cache"
msgstr "Caché de fuentes"

#: src/safe_disk_cleaner/cache_info.py:34
msgid ""
"A list of installed fonts so programs start quickly. Rebuilt automatically "
"in seconds."
msgstr ""
"Una lista de las fuentes instaladas para que los programas arranquen rápido. "
"Se reconstruye sola en segundos."

#: src/safe_disk_cleaner/cache_info.py:36
msgid "Multimedia plugin registry"
msgstr "Registro de plugins multimedia"

#: src/safe_disk_cleaner/cache_info.py:37
msgid ""
"A list of audio/video plugins. Rebuilt automatically the next time media "
"plays."
msgstr ""
"Una lista de plugins de audio y vídeo. Se reconstruye sola la próxima vez "
"que se reproduzca contenido."

#: src/safe_disk_cleaner/cache_info.py:39
msgid "Input method cache"
msgstr "Caché del método de entrada"

#: src/safe_disk_cleaner/cache_info.py:39
msgid "Keyboard input method data. Rebuilt automatically."
msgstr "Datos del método de entrada de teclado. Se reconstruye solo."

#: src/safe_disk_cleaner/cache_info.py:40
msgid "GNOME Software cache"
msgstr "Caché de GNOME Software"

#: src/safe_disk_cleaner/cache_info.py:41
msgid ""
"App icons, screenshots and update information shown in the Software app. "
"Downloaded again when needed."
msgstr ""
"Iconos de apps, capturas e información de actualizaciones que muestra la app "
"Software. Se descargan de nuevo cuando hacen falta."

#: src/safe_disk_cleaner/cache_info.py:42
msgid "Ubuntu report data"
msgstr "Datos del informe de Ubuntu"

#: src/safe_disk_cleaner/cache_info.py:42
msgid "Leftover data from Ubuntu's optional system report."
msgstr "Datos sobrantes del informe opcional del sistema de Ubuntu."

#: src/safe_disk_cleaner/cache_info.py:43
msgid "Weather cache"
msgstr "Caché del clima"

#: src/safe_disk_cleaner/cache_info.py:43
msgid "Recent weather data. Downloaded again."
msgstr "Datos recientes del clima. Se descargan de nuevo."

#: src/safe_disk_cleaner/cache_info.py:44
msgid "Image library cache"
msgstr "Caché de la biblioteca de imágenes"

#: src/safe_disk_cleaner/cache_info.py:44
msgid "Speed-up data for GIMP's colour library. Rebuilt automatically."
msgstr ""
"Datos de aceleración de la biblioteca de colores de GIMP. Se reconstruyen "
"solos."

#: src/safe_disk_cleaner/cache_info.py:45
msgid "Thumbnailer temp files"
msgstr "Temporales del generador de miniaturas"

#: src/safe_disk_cleaner/cache_info.py:45
msgid "Temporary files from making previews."
msgstr "Archivos temporales de la creación de previsualizaciones."

#: src/safe_disk_cleaner/cache_info.py:46
msgid "Bluetooth transfer temp files"
msgstr "Temporales de transferencias Bluetooth"

#: src/safe_disk_cleaner/cache_info.py:46
msgid "Temporary files from Bluetooth file transfers."
msgstr "Archivos temporales de las transferencias de archivos por Bluetooth."

#: src/safe_disk_cleaner/cache_info.py:47
msgid "Flatpak temporary data"
msgstr "Datos temporales de Flatpak"

#: src/safe_disk_cleaner/cache_info.py:47
msgid "Temporary data from installing or updating Flatpak apps."
msgstr "Datos temporales de instalar o actualizar apps Flatpak."

#: src/safe_disk_cleaner/cache_info.py:49
msgid "Spotify cache"
msgstr "Caché de Spotify"

#: src/safe_disk_cleaner/cache_info.py:50
msgid ""
"Music Spotify streamed recently AND songs you downloaded for offline "
"listening. Cleaning removes your offline downloads too."
msgstr ""
"Música que Spotify transmitió hace poco Y canciones que descargaste para "
"escuchar sin conexión. Limpiar también borra tus descargas sin conexión."

#: src/safe_disk_cleaner/cache_info.py:52
#: src/safe_disk_cleaner/cache_info.py:55
msgid "Graphics shader cache (Mesa)"
msgstr "Caché de shaders gráficos (Mesa)"

#: src/safe_disk_cleaner/cache_info.py:53
#: src/safe_disk_cleaner/cache_info.py:56
msgid ""
"Pre-compiled graphics code for games and apps on AMD/Intel GPUs. Deleting it "
"makes games stutter for a while until shaders are compiled again."
msgstr ""
"Código gráfico precompilado para juegos y apps en GPUs AMD/Intel. Borrarlo "
"hace que los juegos den tirones un rato hasta que se recompilen los shaders."

#: src/safe_disk_cleaner/cache_info.py:58
msgid "Graphics shader cache (AMD)"
msgstr "Caché de shaders gráficos (AMD)"

#: src/safe_disk_cleaner/cache_info.py:59
msgid "Pre-compiled shaders for AMD graphics. Rebuilt automatically."
msgstr "Shaders precompilados para gráficas AMD. Se reconstruyen solos."

#: src/safe_disk_cleaner/cache_info.py:60
msgid "Graphics shader cache (NVIDIA)"
msgstr "Caché de shaders gráficos (NVIDIA)"

#: src/safe_disk_cleaner/cache_info.py:61
msgid ""
"Pre-compiled graphics code from the NVIDIA driver. Games may stutter briefly "
"afterwards."
msgstr ""
"Código gráfico precompilado del driver de NVIDIA. Los juegos pueden dar "
"tirones breves después."

#: src/safe_disk_cleaner/cache_info.py:63
msgid "Wine installers cache"
msgstr "Caché de instaladores de Wine"

#: src/safe_disk_cleaner/cache_info.py:64
msgid ""
"Downloaded Wine Gecko/Mono installers. Downloaded again if a new Wine prefix "
"needs them."
msgstr ""
"Instaladores de Wine Gecko/Mono descargados. Se descargan de nuevo si un "
"prefijo de Wine nuevo los necesita."

#: src/safe_disk_cleaner/cache_info.py:66
msgid "Winetricks downloads"
msgstr "Descargas de Winetricks"

#: src/safe_disk_cleaner/cache_info.py:67
msgid ""
"Installers Winetricks downloaded (fonts, runtimes). Downloaded again when "
"needed."
msgstr ""
"Instaladores que descargó Winetricks (fuentes, runtimes). Se descargan de "
"nuevo cuando hacen falta."

#: src/safe_disk_cleaner/cache_info.py:69
msgid "Lutris cache"
msgstr "Caché de Lutris"

#: src/safe_disk_cleaner/cache_info.py:69
msgid ""
"Downloaded installers and banners from Lutris. Downloaded again when needed."
msgstr ""
"Instaladores y banners descargados de Lutris. Se descargan de nuevo cuando "
"hacen falta."

#: src/safe_disk_cleaner/cache_info.py:72
msgid "Python pip download cache"
msgstr "Caché de descargas de pip (Python)"

#: src/safe_disk_cleaner/cache_info.py:73
msgid ""
"Python packages pip downloaded before. Installed packages keep working; pip "
"just downloads again next time."
msgstr ""
"Paquetes de Python que pip descargó antes. Los paquetes instalados siguen "
"funcionando; pip solo los vuelve a descargar la próxima vez."

#: src/safe_disk_cleaner/cache_info.py:74
msgid "Python uv cache"
msgstr "Caché de uv (Python)"

#: src/safe_disk_cleaner/cache_info.py:74
msgid "Python packages downloaded by uv. Existing environments keep working."
msgstr ""
"Paquetes de Python descargados por uv. Los entornos existentes siguen "
"funcionando."

#: src/safe_disk_cleaner/cache_info.py:76
msgid "Poetry cache"
msgstr "Caché de Poetry"

#: src/safe_disk_cleaner/cache_info.py:77
msgid ""
"Poetry's package cache — and, by default, Poetry's VIRTUAL ENVIRONMENTS for "
"your projects. They can be recreated with `poetry install`."
msgstr ""
"La caché de paquetes de Poetry y, por defecto, los ENTORNOS VIRTUALES de "
"Poetry de tus proyectos. Se pueden recrear con `poetry install`."

#: src/safe_disk_cleaner/cache_info.py:78
msgid "Go build cache"
msgstr "Caché de compilación de Go"

#: src/safe_disk_cleaner/cache_info.py:78
msgid "Compiled Go code. Rebuilt automatically on the next `go build`."
msgstr "Código Go compilado. Se reconstruye solo en el próximo `go build`."

#: src/safe_disk_cleaner/cache_info.py:80
msgid "Yarn package cache"
msgstr "Caché de paquetes de Yarn"

#: src/safe_disk_cleaner/cache_info.py:80
msgid "JavaScript packages Yarn downloaded. Downloaded again when needed."
msgstr ""
"Paquetes de JavaScript que descargó Yarn. Se descargan de nuevo cuando hacen "
"falta."

#: src/safe_disk_cleaner/cache_info.py:82
msgid "pnpm cache"
msgstr "Caché de pnpm"

#: src/safe_disk_cleaner/cache_info.py:82
msgid "JavaScript package metadata. Downloaded again when needed."
msgstr ""
"Metadatos de paquetes de JavaScript. Se descargan de nuevo cuando hacen "
"falta."

#: src/safe_disk_cleaner/cache_info.py:83
msgid "node-gyp headers"
msgstr "Cabeceras de node-gyp"

#: src/safe_disk_cleaner/cache_info.py:83
msgid "Node.js headers for building native modules. Re-downloaded."
msgstr ""
"Cabeceras de Node.js para compilar módulos nativos. Se vuelven a descargar."

#: src/safe_disk_cleaner/cache_info.py:85
msgid "Electron downloads"
msgstr "Descargas de Electron"

#: src/safe_disk_cleaner/cache_info.py:85
msgid "Electron runtime downloads from development tools."
msgstr "Descargas del runtime de Electron de las herramientas de desarrollo."

#: src/safe_disk_cleaner/cache_info.py:86
msgid "TypeScript type cache"
msgstr "Caché de tipos de TypeScript"

#: src/safe_disk_cleaner/cache_info.py:86
msgid "Downloaded type definitions for editors."
msgstr "Definiciones de tipos descargadas para los editores."

#: src/safe_disk_cleaner/cache_info.py:87
msgid "Deno cache"
msgstr "Caché de Deno"

#: src/safe_disk_cleaner/cache_info.py:87
msgid "Downloaded Deno modules. Downloaded again when needed."
msgstr "Módulos de Deno descargados. Se descargan de nuevo cuando hacen falta."

#: src/safe_disk_cleaner/cache_info.py:88
msgid "PHP Composer cache"
msgstr "Caché de PHP Composer"

#: src/safe_disk_cleaner/cache_info.py:88
msgid "Downloaded PHP packages."
msgstr "Paquetes de PHP descargados."

#: src/safe_disk_cleaner/cache_info.py:89
msgid "C/C++ compiler cache"
msgstr "Caché del compilador de C/C++"

#: src/safe_disk_cleaner/cache_info.py:89
msgid "Speeds up recompiling C/C++ code. Builds are slower once."
msgstr "Acelera recompilar código C/C++. Las compilaciones tardan más una vez."

#: src/safe_disk_cleaner/cache_info.py:91
msgid "Compiler cache (sccache)"
msgstr "Caché del compilador (sccache)"

#: src/safe_disk_cleaner/cache_info.py:91
msgid "Speeds up recompiling code. Builds are slower once."
msgstr "Acelera recompilar código. Las compilaciones tardan más una vez."

#: src/safe_disk_cleaner/cache_info.py:92
msgid "Bazel build outputs"
msgstr "Salidas de compilación de Bazel"

#: src/safe_disk_cleaner/cache_info.py:92
msgid "Build outputs and downloads of Bazel projects."
msgstr "Salidas de compilación y descargas de proyectos Bazel."

#: src/safe_disk_cleaner/cache_info.py:93
msgid "JetBrains IDE caches"
msgstr "Cachés de los IDE de JetBrains"

#: src/safe_disk_cleaner/cache_info.py:94
msgid ""
"Indexes and caches of IntelliJ, PyCharm, etc. The IDE re-indexes your "
"projects (slow the first time). Close the IDE first."
msgstr ""
"Índices y cachés de IntelliJ, PyCharm, etc. El IDE vuelve a indexar tus "
"proyectos (lento la primera vez). Cerrá el IDE antes."

#: src/safe_disk_cleaner/cache_info.py:96
msgid "VS Code C++ IntelliSense cache"
msgstr "Caché de IntelliSense de C++ de VS Code"

#: src/safe_disk_cleaner/cache_info.py:96
msgid "Rebuilt automatically by VS Code."
msgstr "La reconstruye sola VS Code."

#: src/safe_disk_cleaner/cache_info.py:97
msgid "Playwright test browsers"
msgstr "Navegadores de prueba de Playwright"

#: src/safe_disk_cleaner/cache_info.py:98
msgid ""
"Browsers downloaded for automated web testing. Development projects that use "
"Playwright will need `npx playwright install` again."
msgstr ""
"Navegadores descargados para pruebas web automatizadas. Los proyectos de "
"desarrollo que usan Playwright necesitarán `npx playwright install` otra vez."

#: src/safe_disk_cleaner/cache_info.py:99
msgid "Hugging Face AI models"
msgstr "Modelos de IA de Hugging Face"

#: src/safe_disk_cleaner/cache_info.py:100
msgid ""
"Downloaded AI models and datasets. They can be several GB each and take a "
"long time to download again."
msgstr ""
"Modelos y conjuntos de datos de IA descargados. Pueden ocupar varios GB cada "
"uno y tardar mucho en descargarse de nuevo."

#: src/safe_disk_cleaner/cache_info.py:101
msgid "PyTorch model downloads"
msgstr "Descargas de modelos de PyTorch"

#: src/safe_disk_cleaner/cache_info.py:101
msgid "Downloaded machine-learning models. Re-downloaded when needed."
msgstr ""
"Modelos de aprendizaje automático descargados. Se vuelven a descargar cuando "
"hacen falta."

#: src/safe_disk_cleaner/cache_info.py:103
msgid "yay AUR build files"
msgstr "Archivos de compilación AUR de yay"

#: src/safe_disk_cleaner/cache_info.py:103
#: src/safe_disk_cleaner/cache_info.py:104
msgid "Build folders from installing AUR packages. Safe to delete."
msgstr "Carpetas de compilación de instalar paquetes AUR. Es seguro borrarlas."

#: src/safe_disk_cleaner/cache_info.py:104
msgid "paru AUR build files"
msgstr "Archivos de compilación AUR de paru"

#: src/safe_disk_cleaner/cache_info.py:111
#, python-brace-format
msgid ""
"Temporary data saved by “{name}”. Programs put things here they can rebuild "
"or re-download, so deleting it is usually harmless — the program may just be "
"slower the next time it starts. Close it first."
msgstr ""
"Datos temporales guardados por “{name}”. Los programas ponen acá cosas que "
"pueden reconstruir o volver a descargar, así que borrarlo suele ser "
"inofensivo; el programa quizá vaya más lento la próxima vez que arranque. "
"Cerralo antes."

#: src/safe_disk_cleaner/cleaner.py:70
#, python-brace-format
msgid "delete {arg0}"
msgstr "borrar {arg0}"

#: src/safe_disk_cleaner/cleaner.py:72
#, python-brace-format
msgid "delete {arg0} files/folders in {arg1}"
msgstr "borrar {arg0} archivos/carpetas en {arg1}"

#: src/safe_disk_cleaner/cleaner.py:141 src/safe_disk_cleaner/helper.py:330
#, python-brace-format
msgid "{arg0} is outside {arg1}"
msgstr "{arg0} está fuera de {arg1}"

#: src/safe_disk_cleaner/cleaner.py:144 src/safe_disk_cleaner/helper.py:333
#, python-brace-format
msgid "bad path {arg0}"
msgstr "ruta inválida {arg0}"

#: src/safe_disk_cleaner/cleaner.py:220
msgid ""
"pkexec (package “pkexec” or “polkit”) is not installed, so administrator "
"tasks can't run."
msgstr ""
"pkexec (el paquete “pkexec” o “polkit”) no está instalado, así que las "
"tareas de administrador no pueden ejecutarse."

#: src/safe_disk_cleaner/cleaner.py:230
msgid "Asking for your password…"
msgstr "Pidiendo tu contraseña…"

#: src/safe_disk_cleaner/cleaner.py:235
#, python-brace-format
msgid "Could not start the helper: {arg0}"
msgstr "No se pudo iniciar el asistente: {arg0}"

#: src/safe_disk_cleaner/cleaner.py:274
msgid ""
"Administrator tasks were skipped: the password prompt was cancelled or not "
"allowed."
msgstr ""
"Se omitieron las tareas de administrador: se canceló o no se permitió el "
"pedido de contraseña."

#: src/safe_disk_cleaner/cleaner.py:276
msgid "The helper stopped unexpectedly. "
msgstr "El asistente se detuvo inesperadamente. "

#: src/safe_disk_cleaner/cleaner.py:291
#, python-brace-format
msgid "→ Deleting {arg0} item(s) in {arg1}"
msgstr "→ Borrando {arg0} elemento(s) en {arg1}"

#: src/safe_disk_cleaner/cleaner.py:300
#, python-brace-format
msgid "   skipped {arg0}: {arg1} is running"
msgstr "   omitido: {arg0}: {arg1} está en ejecución"

#: src/safe_disk_cleaner/cleaner.py:303 src/safe_disk_cleaner/cleaner.py:306
#, python-brace-format
msgid "   skipped {arg0}: the app is running"
msgstr "   omitido: {arg0}: la app está en ejecución"

#: src/safe_disk_cleaner/cleaner.py:314
#, python-brace-format
msgid "   deleted {arg0}"
msgstr "   eliminado: {arg0}"

#: src/safe_disk_cleaner/cleaner.py:324
msgid "Removing your personal Flatpak runtimes failed."
msgstr "No se pudieron eliminar tus runtimes de Flatpak personales."

#: src/safe_disk_cleaner/helper.py:56
#, python-brace-format
msgid "exit code {arg0}, no error message"
msgstr "código de salida {arg0}, sin mensaje de error"

#: src/safe_disk_cleaner/helper.py:66
msgid "could not look up the user who started the app"
msgstr "no se pudo averiguar el usuario que inició la app"

#: src/safe_disk_cleaner/helper.py:76
msgid "Flatpak could not list unused runtimes: "
msgstr "Flatpak no pudo listar los runtimes no usados: "

#: src/safe_disk_cleaner/helper.py:91
#, python-brace-format
msgid "{arg0} is not installed"
msgstr "{arg0} no está instalado"

#: src/safe_disk_cleaner/helper.py:120
#, python-brace-format
msgid "{arg0} failed (exit code {arg1})"
msgstr "{arg0} falló (código de salida {arg1})"

#: src/safe_disk_cleaner/helper.py:130 src/safe_disk_cleaner/helper.py:239
msgid "unknown package manager"
msgstr "gestor de paquetes desconocido"

#: src/safe_disk_cleaner/helper.py:170
msgid "APT could not compute the list of unused packages"
msgstr "APT no pudo calcular la lista de paquetes no usados"

#: src/safe_disk_cleaner/helper.py:182
msgid "no packages given"
msgstr "no se indicaron paquetes"

#: src/safe_disk_cleaner/helper.py:184
msgid "unknown purpose"
msgstr "propósito desconocido"

#: src/safe_disk_cleaner/helper.py:186
msgid "kernel cleaning is only supported with APT"
msgstr "la limpieza de kernels solo está soportada con APT"

#: src/safe_disk_cleaner/helper.py:190
msgid "invalid package name: {arg0!r}"
msgstr "nombre de paquete inválido: {arg0!r}"

#: src/safe_disk_cleaner/helper.py:199
#, python-brace-format
msgid "{arg0} belongs to the running kernel"
msgstr "{arg0} pertenece al kernel en ejecución"

#: src/safe_disk_cleaner/helper.py:202
msgid "no longer safe to remove (system changed since the scan): "
msgstr "ya no es seguro eliminarlo (el sistema cambió desde el escaneo): "

#: src/safe_disk_cleaner/helper.py:209
msgid "APT dry run failed: "
msgstr "falló la simulación de APT: "

#: src/safe_disk_cleaner/helper.py:212
msgid "APT would also remove packages you didn't select: "
msgstr "APT también eliminaría paquetes que no seleccionaste: "

#: src/safe_disk_cleaner/helper.py:220
msgid "no longer unneeded: "
msgstr "ya no es innecesario: "

#: src/safe_disk_cleaner/helper.py:227
msgid "no longer orphaned: "
msgstr "ya no está huérfano: "

#: src/safe_disk_cleaner/helper.py:231
msgid "pacman's dry run failed: "
msgstr "falló la simulación de pacman: "

#: src/safe_disk_cleaner/helper.py:234
msgid "pacman would also remove packages you didn't select: "
msgstr "pacman también eliminaría paquetes que no seleccionaste: "

#: src/safe_disk_cleaner/helper.py:249
msgid "invalid snap name or revision"
msgstr "nombre o revisión de snap inválidos"

#: src/safe_disk_cleaner/helper.py:253
#, python-brace-format
msgid "{arg0} revision {arg1} is not a disabled (old) revision anymore"
msgstr "{arg0} revisión {arg1} ya no es una revisión deshabilitada (antigua)"

#: src/safe_disk_cleaner/helper.py:260
msgid "refresh.retain must be 2 or 3"
msgstr "refresh.retain debe ser 2 o 3"

#: src/safe_disk_cleaner/helper.py:271
msgid "unsupported journal size"
msgstr "tamaño de journal no soportado"

#: src/safe_disk_cleaner/helper.py:278
msgid "unsupported journal limit"
msgstr "límite de journal no soportado"

#: src/safe_disk_cleaner/helper.py:282
#, python-brace-format
msgid "Removed {arg0}"
msgstr "Eliminado: {arg0}"

#: src/safe_disk_cleaner/helper.py:288
#, python-brace-format
msgid ""
"# Written by Safe Disk Cleaner. Delete this file to go back to the default.\n"
"[Journal]\n"
"SystemMaxUse={arg0}\n"
msgstr ""
"# Escrito por Safe Disk Cleaner. Borrá este archivo para volver al valor por "
"defecto. \n"
"[Journal]\n"
"SystemMaxUse={arg0}\n"

