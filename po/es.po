msgstr " · borrado el {arg0}"

#: src/safe_disk_cleaner/scanners.py:1003
msgid "Half-deleted leftovers"
msgstr "Restos a medio borrar"

#: src/safe_disk_cleaner/scanners.py:1004
msgid "Files the file manager started to delete but didn't finish"
msgstr "Archivos que el gestor empezó a borrar pero no terminó"

#: src/safe_disk_cleaner/scanners.py:1017
#, python-brace-format
msgid "{arg0} smaller items"
msgstr "{arg0} elementos más pequeños"

#: src/safe_disk_cleaner/scanners.py:1018
msgid "Everything else in the Trash"
msgstr "Todo lo demás de la papelera"

#: src/safe_disk_cleaner/scanners.py:1023
msgid "The Trash is empty."
msgstr "La papelera está vacía."

#: src/safe_disk_cleaner/scanners.py:1052
#, python-brace-format
