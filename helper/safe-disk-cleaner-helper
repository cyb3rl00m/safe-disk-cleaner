#!/usr/bin/python3 -I
"""Root helper launcher, started by the app through pkexec.

Installed as <prefix>/libexec/safe-disk-cleaner-helper (prefix /usr for the .deb,
/usr/local for install.sh). It only ever loads code from the root-owned
<prefix>/lib/safe-disk-cleaner next to it. When run from the source folder
(development), it loads ../src next to itself.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
if os.path.basename(HERE) == "libexec":
    LIB = os.path.join(os.path.dirname(HERE), "lib", "safe-disk-cleaner")
else:
    LIB = os.path.join(os.path.dirname(HERE), "src")
sys.path.insert(0, LIB)

from safe_disk_cleaner.helper import main  # noqa: E402

sys.exit(main())
